package homepage_templ 

templ Setup() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>College Assist</title>
			<link id="theme" rel="stylesheet" href="../css/homepage_styles.css"/>
			<script type="module" src="https://cdn.jsdelivr.net/gh/starfederation/datastar@v1.0.0/bundles/datastar.js"></script>
		</head>
		<body>
			<header class="app-header">
				<div class="header-left">
					<a href="/" class="brand-link">
						<div class="brand-icon">
							<svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
							</svg>
						</div>
						<span class="brand-text">College Assist</span>
					</a>
				</div>
				<nav class="main-nav">
					<a href="#features">Features</a>
					<a href="#testimonials">Testimonials</a>
				</nav>
				<div class="header-right">
					<a class="btn btn-ghost" id="signin-btn" href="/login">
						Sign In
					</a>
					<a class="btn btn-ghost" id="signup-btn" href="/signup">
						Get Started Free
					</a>
				</div>
			</header>
			<main>
				<section id="promise-to-users">
					<div id="prom-title-container">
						<h1 id="prom-title">Stop Planning, Start Learning</h1>
						<h2 id="prom-subtitle">The all-in-one AI study assistant that turns your syllabus into a master schedule, generates custom practice quizzes, and automates your entire study routine.</h2>
					</div>
				</section>
			</main>
		</body>
	</html>
}
