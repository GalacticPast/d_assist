package dashboard_templ 

import "d_assist/internal/types"
import "fmt"

templ layout() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>College Assist Dashboard</title>
			<link rel="stylesheet" href="../css/dashboard_styles.css"/>
			<script type="module" src="https://cdn.jsdelivr.net/gh/starfederation/datastar@v1.0.0/bundles/datastar.js"></script>
			<script src="../scripts/file_upload.js"></script>
			<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
		</head>
		<body>
			<div class="app-shell">
				<header class="app-header">
					<div class="header-left">
						<a href="/" class="brand-link">
							<div class="brand-icon">
								<svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
								</svg>
							</div>
							<span class="brand-text">College Assist</span>
						</a>
						<nav class="main-nav">
							<a href="/dashboard" class="active">Courses</a>
							<a href="/courses">Calendar</a>
						</nav>
					</div>
					<div class="header-right">
						<button class="btn btn-ghost">
							<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
							Sign Out
						</button>
					</div>
				</header>
				<input type="text" id="is_uploading" data-bind:is_uploading style="display: none"/>
				<main class="main-content">
					{ children... }
				</main>
			</div>
		</body>
	</html>
}

// this is kinda shit
templ Setup(curr_selected_course int, courses *[]da_types.Course) {
	{{ course_count := len(*courses) }}
	@layout() {
		<div id="loader-container" data-show="$is_uploading == 'show_spinner'" style="display: none">
			<h2 id="loader-h2">Wait a while we process your document.</h2>
			<span id="loader-spinner" class="loader"></span>
		</div>
		if course_count == 0 {
			<div id="empty-dashboard" data-show="$is_uploading == ''">
				<h1 class="empty-courses">
					Start uploading syllabi to get
					<span class="text-gradient">Started</span>
				</h1>
				<div id="dropzone">
					<div id="icon-container">
						<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
							<polyline points="14 2 14 8 20 8"></polyline>
							<line x1="12" y1="18" x2="12" y2="12"></line>
							<polyline points="9 15 12 12 15 15"></polyline>
						</svg>
					</div>
					<h2>Drag & drop your syllabus PDF</h2>
					<p>or click to browse from your computer</p>
					<input type="file" accept="application/pdf" class="file-input" id="syllabus-upload" hidden/>
					<button class="select-btn" id="syllabus-upload-btn">Upload Syllabus</button>
				</div>
			</div>
		} else {
			@Show_courses_content(curr_selected_course, courses)
		}
	}
}

templ Show_spinner() {
	<div id="loader-container">
		<h2 id="loader-h2">Wait a while we process your document.</h2>
		<span id="loader-spinner" class="loader"></span>
	</div>
}

templ Show_courses_content(curr_selected_course int, courses *[]da_types.Course) {
	<main>
		<section id="courses">
			<div id="courses-tab-container">
				@get_course_sections(curr_selected_course, courses)
			</div>
			<div id="course-quizzes">
				@get_curr_course_quizzes(&(*courses)[curr_selected_course])
			</div>
		</section>
	</main>
}

templ get_course_sections(curr_selected_course int, courses *[]da_types.Course) {
	for index, course := range *courses {
		<div class={ "tab", templ.KV("active", index == curr_selected_course) }>
			<svg class="tab-icon" viewBox="0 0 24 24" fill="{course.Color}" stroke="black" stroke-width="2">
				<circle cx="12" cy="12" r="10"></circle>
			</svg>
			<span>{ course.Title }</span>
		</div>
	}
}

templ get_curr_course_badge(course *da_types.Course) {
	<div class="content-header">
		<h3 class="content-title">
			{ course.Title }
			<span class="course-badge">{ course.Badge }</span>
		</h3>
	</div>
}

templ get_curr_course_quizzes(course *da_types.Course) {
	{{
		quizzes := course.Quizzes
		quiz_length := len(quizzes)
	}}
	if quiz_length != 0 {
		for _, quiz := range quizzes {
			<div class="quiz">
				<span class="quiz-title">{ quiz.Title }</span>
				data-on:click={ fmt.Sprintf("@get('/get_quiz/{%s}')", quiz.Title) }
			</div>
		}
	} else {
		<article class="task-card">
			<div class="task-info">
                <inpu5     if (slides_pdf_file_input.files.length > 0) {                                  │  5            </div>upload_filet type="file" accept="application/pdf" class="file-input" id="slides-upload" hidden/>
				<div class="slide-upload-btn">
					<h3 class="task-name">Click here to upload class slides to generate content</h3>
				</div>
			</div>
		</article>
	}upload_file
}upload_file
